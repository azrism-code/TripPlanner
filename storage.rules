rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function tripData(tripId) {
      return firestore.get(/databases/(default)/documents/trips/$(tripId)).data;
    }

    function isOwner(tripId) {
      return signedIn() && tripData(tripId).ownerId == request.auth.uid;
    }

    function isViewer(tripId) {
      return signedIn()
        && request.auth.token.email != null
        && ('sharedWithEmails' in tripData(tripId))
        && tripData(tripId).sharedWithEmails is list
        && request.auth.token.email.lower() in tripData(tripId).sharedWithEmails;
    }

    match /trips/{tripId}/documents/{fileName} {
      allow read: if isOwner(tripId) || isViewer(tripId);
      allow create, update: if signedIn()
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if signedIn()
        && (isOwner(tripId) || fileName.matches('^' + request.auth.uid + '-.*'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
