rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTripOwner(tripData) {
      return signedIn() && tripData.ownerId == request.auth.uid;
    }

    function isTripViewer(tripData) {
      return signedIn()
        && request.auth.token.email != null
        && ('sharedWithEmails' in tripData)
        && tripData.sharedWithEmails is list
        && request.auth.token.email.lower() in tripData.sharedWithEmails;
    }

    function canReadTrip(tripData) {
      return isAdmin() || isTripOwner(tripData) || isTripViewer(tripData);
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user';

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow update: if signedIn()
        && (
          isAdmin()
          || (
            request.auth.uid == userId
            && request.resource.data.role == resource.data.role
          )
        );

      allow delete: if isAdmin();
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if signedIn() && canReadTrip(resource.data);

      allow delete: if signedIn()
        && (isAdmin() || isTripOwner(resource.data));

      allow update: if signedIn()
        && (
          isAdmin()
          || (
            isTripOwner(resource.data)
            && request.resource.data.ownerId == resource.data.ownerId
          )
        );

      match /{document=**} {
        allow read: if signedIn() && canReadTrip(tripData(tripId));

        allow write: if signedIn()
          && (
            isAdmin()
            || tripData(tripId).ownerId == request.auth.uid
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
